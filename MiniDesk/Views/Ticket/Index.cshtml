@functions {
    string GetStatusText(TicketStatus status)
    {
        return status switch
        {
            TicketStatus.Pending => "대기",
            TicketStatus.InProgress => "처리중",
            TicketStatus.Completed => "완료",
            _ => ""
        };
    }

    string GetPriorityText(TicketPriority priority)
    {
        return priority switch
        {
            TicketPriority.Low => "낮음",
            TicketPriority.Normal => "보통",
            TicketPriority.High => "높음",
            TicketPriority.Critical => "긴급",
            _ => ""
        };
    }
}