@using System.Security.Claims
@using MiniDesk.Services
@inject NotificationService NotificationService

@{
    //var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var unreadCount = 0;

    if (int.TryParse(userIdString, out var currentUserId))
    {
        unreadCount = await NotificationService.GetUnreadCountAsync(currentUserId);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniDesk.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">MiniDesk</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-nav">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        <a class="nav-link" asp-controller="Ticket" asp-action="Index">요청관리</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link" asp-controller="User" asp-action="Index">사용자관리</a>
                        }
                    </div>
                    <div class="ms-auto d-flex align-items-center">
                        <!-- 알림 -->
                        <a class="nav-link text-white me-3 position-relative"
                            asp-controller="Notification"
                            asp-action="Index">
                            🔔 알림

                            @if (unreadCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@unreadCount</span>
                            }
                        </a>

                        <!-- 사용자 -->
                        <span class="text-black me-3">@User.Identity.Name</span>
                        <!-- 로그아웃 -->
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">로그아웃</a>
                    </div>
                }
            </div>
        </nav>
        @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MiniDesk</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> *@
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MiniDesk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
